# ============================================================
# KUSANGA KITADI — Variáveis de Ambiente de Produção
# ============================================================
# Copia este ficheiro para .env (desenvolvimento local) ou
# configura estas variáveis no painel do Cloudflare Pages /
# Workers antes do deploy em produção.
#
# ATENÇÃO: NUNCA commites o teu ficheiro .env com valores reais
# para o repositório Git. O .gitignore já exclui .env por padrão.
# ============================================================

# --- Supabase ---
# URL do teu projecto Supabase (encontras em: Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública anónima (encontras em: Project Settings > API > anon public)
# Esta chave é segura para o cliente — NÃO é a service_role key.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ATENÇÃO: Nunca expor no cliente ---
# A SUPABASE_SERVICE_ROLE_KEY nunca deve ter o prefixo VITE_
# Apenas deve ser usada em funções Edge / backend seguro.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Ambiente (opcional) ---
# NODE_ENV=production
